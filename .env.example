# ── Shopify app credentials (Partner Dashboard / `shopify app config link`) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_customers,write_customers,read_orders,read_products,write_products,read_purchase_options,write_purchase_options,read_own_subscription_contracts,write_own_subscription_contracts,read_customer_payment_methods

# ── Database ─────────────────────────────────────────────────────────────────
# Dev: SQLite (path resolves relative to prisma/schema.prisma).
# Production: a Postgres URL + `npm run setup:postgres` (uses prisma/postgres/).
DATABASE_URL="file:./dev.sqlite"

# ── Required secrets ─────────────────────────────────────────────────────────
# Signs portal magic-link tokens + encrypts stored secrets. openssl rand -hex 32
MAGIC_LINK_SECRET=
# Bearer token protecting the scheduled-jobs endpoint POST /jobs/:job
JOB_SECRET=

# ── Portal (optional) ────────────────────────────────────────────────────────
# Base URL customers use to reach the portal (defaults to SHOPIFY_APP_URL)
PORTAL_BASE_URL=
# Support address shown in portal footers/gates (default care@cellexia.com)
PORTAL_SUPPORT_EMAIL=
# CDN base for Gobold/Argumentum woff2 files (portal falls back to system fonts)
PORTAL_FONT_BASE_URL=
# Only for multi-shop installs: which shop the portal login page serves
PORTAL_SHOP=

# ── Optional infrastructure ──────────────────────────────────────────────────
# Custom shop domain, if the store doesn't use *.myshopify.com for OAuth
SHOP_CUSTOM_DOMAIN=

# NOTE: the Klaviyo private API key is NOT an env var — it is entered in the
# app admin (Settings → Integrations) and stored encrypted in the database.

# ── LOCAL DEMO ONLY — never set these on a production host ──────────────────
# DEMO_MODE=1 bypasses Shopify admin auth. It is refused unless
# SHOPIFY_APP_URL is localhost (see app/shopify.server.ts).
# DEMO_MODE=
# DEMO_SHOP=
