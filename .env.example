# ── Shopify app credentials (from Partner Dashboard after creating the app) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-host.example.com
SCOPES=read_customers,write_customers,read_orders,write_orders,write_order_edits,read_products,write_products,read_purchase_options,write_purchase_options,read_own_subscription_contracts,write_own_subscription_contracts,read_customer_payment_methods,write_customer_payment_methods,read_locales,read_markets,read_inventory,read_fulfillments,read_discounts

# ── Database (PostgreSQL required in production) ──
DATABASE_URL=postgresql://user:password@localhost:5432/cellexia

# ── Application secrets (generate with: openssl rand -hex 32) ──
# Signs magic links, portal sessions and OTP codes. Rotating it invalidates
# all outstanding links — see docs/OPERATIONS.md before rotating.
APP_SIGNING_SECRET=
# Protects the /api/jobs/run endpoint used by external cron.
CRON_SECRET=

# ── Scheduler ──
# "internal" runs the billing scheduler inside the web process (single-instance
# hosts). "external" disables the internal loop; hit /api/jobs/run via cron.
SCHEDULER_MODE=internal
# Default shop timezone fallback; the shop's own IANA timezone is used once synced.
DEFAULT_TIMEZONE=Europe/London

# ── Klaviyo ──
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_API_REVISION=2025-01-15

# ── Transactional email (OTP codes + fallback if a Klaviyo flow is not live) ──
# provider: "smtp" | "console" (console logs emails; use for local dev only)
MAIL_PROVIDER=console
MAIL_FROM="Cellexia <care@cellexia.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS (optional; dunning day-8 SMS + text-to-skip are sent via Klaviyo flows.
# Direct SMS is only used if you wire a provider here.) ──
SMS_PROVIDER=none

# ── Misc ──
NODE_ENV=production
PORT=3000
