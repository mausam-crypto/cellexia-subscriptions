// Cellexia Subscriptions — data model
//
// Conventions:
//  - All money is stored as integer cents (`amountCents`) plus a `currencyCode`.
//  - All Shopify IDs are stored as full GIDs (e.g. "gid://shopify/SubscriptionContract/1").
//  - All timestamps are UTC; scheduling math converts through the shop's IANA timezone.
//  - Shopify is the source of truth for contracts/payment state; these tables are a
//    mirror + extension (dunning, gifts, analytics, magic links live only here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Shopify OAuth session storage (managed by @shopify/shopify-app-session-storage-prisma)

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id             String    @id @default(cuid())
  domain         String    @unique // my-store.myshopify.com
  name           String?
  primaryDomain  String? // www.cellexia.com
  currencyCode   String    @default("GBP")
  ianaTimezone   String    @default("Europe/London")
  contactEmail   String?
  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?
  enabledLocales Json? // [{locale:"en", primary:true}, ...] synced from shop
  lastFullSyncAt DateTime?

  settings        Setting[]
  contracts       SubscriptionContract[]
  planConfigs     SellingPlanConfig[]
  surveyResponses SurveyResponse[]
}

// Typed key/value settings; keys + defaults defined in app/lib/settings/registry.server.ts
model Setting {
  id        String   @id @default(cuid())
  shopId    String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String? // admin user email / "system"

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, key])
}

// ── Selling plans ─────────────────────────────────────────────────────────────

model SellingPlanConfig {
  id                         String   @id @default(cuid())
  shopId                     String
  name                       String // "Cellexia Subscribe & Save"
  shopifyGroupId             String?  @unique // gid://shopify/SellingPlanGroup/...
  // Every selling plan GID this group has ever exposed (append-only union,
  // refreshed on each sync). This is the app's OWNERSHIP evidence: a contract
  // whose lines carry one of these plan ids is ours, anything else is another
  // app's. Retained across plan deletions so a re-sync that drops a frequency
  // can never orphan (and silently un-bill) our own live subscribers.
  shopifyPlanIds             Json? // ["gid://shopify/SellingPlan/...", ...]
  merchantCode               String   @unique @default(cuid())
  productIds                 Json // ["gid://shopify/Product/..."] products this group applies to
  // Frequency options offered, in weeks: e.g. [4,6,8,10,12]. LEGACY as of
  // v1.8.0 — kept written as a whole-week approximation of `frequencies` so a
  // rollback still sees a coherent (week-only) view; readers prefer the
  // multi-unit columns below and fall back here (app/lib/frequency.ts).
  frequenciesWeeks           Json
  defaultFrequencyWeeks      Int      @default(8)
  // Multi-unit frequency truth (v1.8.0): [{unit: DAY|WEEK|MONTH, count}],
  // units mixable within one group. Null on rows saved before v1.8.0 until
  // their next save — consumers fall back to the week columns above.
  frequencies                Json?
  defaultFrequency           Json? // {unit, count}
  // Per-variant default frequency (v1.14.0): {"gid://shopify/ProductVariant/…":
  // {unit, count}} — explicit overrides only; a variant absent here uses the
  // group default above. Each entry must be one of the offered `frequencies`
  // (validated on save, re-filtered on publish). Published to the storefront
  // as shop metafield cellexia.variant_defaults keyed by NUMERIC variant id;
  // the buy box preselects it per variant. No legacy projection: pre-v1.14.0
  // builds never read this column, so a rollback simply loses the per-variant
  // behaviour (group default applies), which is coherent.
  variantDefaultFrequencies  Json?
  allowFrequencyChoice       Boolean  @default(true)
  // Offer architecture — discounts are baked into plan pricing policies (never codes)
  firstOrderDiscountPct      Int      @default(20)
  ongoingDiscountPct         Int      @default(10)
  firstOrderGiftVariantId    String? // optional gift instead of / on top of first-order discount
  // Prepaid (bill once, ship N times). Modeled now; can launch later.
  prepaidEnabled             Boolean  @default(false)
  prepaidDeliveriesPerCharge Int      @default(3)
  prepaidDiscountPct         Int      @default(15)
  // Lock window (v1.13.0): block skip / pause / schedule changes / content
  // reductions / cancel from CUSTOMER surfaces (portal, cancel flow, magic
  // links, SMS) for the first N days after subscribing, so the discounted
  // first order cannot be grabbed and instantly cancelled. 0 = no lock.
  // Admin, dunning and system paths are never blocked. Resolution and anchor
  // rules live in app/lib/contracts/lock.server.ts.
  lockDays                   Int      @default(0)
  // Buy-box presentation
  badgeText                  String?  @default("Most popular")
  showBadge                  Boolean  @default(true)
  preselectSubscription      Boolean  @default(true)
  active                     Boolean  @default(true)
  syncStatus                 String   @default("PENDING") // PENDING | SYNCED | ERROR
  syncError                  String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// Per-product cadence intelligence: real empty dates, not arbitrary monthly.
model ProductCadence {
  id                    String  @id @default(cuid())
  shopId                String
  productId             String // gid
  variantId             String? // optional per-variant override
  title                 String?
  estDaysToEmpty        Int     @default(56) // drives recommended frequency + win-back timing
  recommendedWeeks      Int     @default(8)
  substituteVariantId   String? // used by stockout policy SUBSTITUTE
  stockoutPolicy        String? // null = shop default; DELAY | SKIP_NOTIFY | SUBSTITUTE
  // Merchant-entered COGS override (cents). Beats Shopify inventoryItem cost in
  // the analytics cost resolution (see app/lib/analytics/costs.server.ts):
  // ContractLine.unitCostCents → this override → costModel.cogsFallbackPctOfPrice.
  unitCostCentsOverride Int?

  @@unique([shopId, productId, variantId])
}

// ── Contracts (mirror of Shopify + local state machine extensions) ────────────

enum ContractStatus {
  ACTIVE
  PAUSED
  CANCELLED
  FAILED
  EXPIRED
}

model SubscriptionContract {
  id                String         @id @default(cuid())
  shopId            String
  shopifyContractId String         @unique
  customerId        String // gid://shopify/Customer/...
  email             String
  phone             String?
  firstName         String?
  lastName          String?
  status            ContractStatus @default(ACTIVE)
  locale            String         @default("en")

  currencyCode                    String
  // Cadence. intervalWeeks is the whole-week APPROXIMATION (MONTH≈4wk,
  // DAY→ceil/7) that scheduling/portal/consolidation surfaces key off; the
  // exact Shopify billing policy is mirrored alongside so money math (MRR)
  // never pays the approximation error. Null on rows mirrored before v1.4.0
  // until their next sync — consumers must fall back to intervalWeeks.
  intervalWeeks                   Int
  billingIntervalUnit             String? // DAY | WEEK | MONTH | YEAR (Shopify SellingPlanInterval)
  billingIntervalCount            Int?
  // Billing-policy cycle bounds (migration 0016), mirrored from the same
  // Shopify billing policy as the interval columns: minCycles the contract is
  // committed to, maxCycles after which Shopify expires it. Read by the portal
  // (commitment-aware cancel guards) and by expiry analytics alongside
  // expiredAt. Null = no bound set on the plan (the common case); also null on
  // rows mirrored before 0016 until their next sync.
  billingMinCycles                Int?
  billingMaxCycles                Int?
  nextBillingDate                 DateTime?
  // Pause state
  pausedAt                        DateTime?
  resumeAt                        DateTime? // auto-resume date (pause is 1–3 months)
  // Why the contract paused (migration 0016), stamped by whichever path pauses
  // it — the pause analogue of cancelReason: CUSTOMER | ADMIN | SAVE_FLOW |
  // STOCKOUT_DELAY | SYSTEM. Read by retention analytics and the admin
  // timeline; null on pauses taken before 0016 ("reason not recorded").
  pausedReason                    String?
  // Cancel state
  cancelledAt                     DateTime?
  cancelReason                    String?
  cancelSource                    String? // CUSTOMER | ADMIN | DUNNING | SYSTEM
  // Expiry state (migration 0016): stamped when the mirror flips status
  // EXPIRED (Shopify ends a contract whose billingMaxCycles ran out), so
  // lifecycle analytics can date the expiry the way cancelledAt dates a
  // cancel. Null on rows that expired before 0016 — status stays the truth,
  // this column only adds the WHEN.
  expiredAt                       DateTime?
  // Failure / dunning
  failedAt                        DateTime?
  consecutiveFailures             Int       @default(0)
  // Prepaid
  isPrepaid                       Boolean   @default(false)
  prepaidDeliveriesPerCharge      Int?
  prepaidDeliveriesRemaining      Int?
  // Payment
  paymentMethodId                 String? // gid://shopify/CustomerPaymentMethod/...
  backupPaymentMethodId           String?
  cardBrand                       String?
  cardLast4                       String?
  cardExpiryMonth                 Int?
  cardExpiryYear                  Int?
  // Delivery
  deliveryAddress                 Json?
  deliveryPriceCents              Int       @default(0)
  deliveryMethodTitle             String?
  // Lock window commitment as SUBSCRIBED UNDER (v1.13.0): the covering
  // plan's lockDays at mirror creation, stamped once on the webhook-create
  // path and never rewritten. Null = row predates the feature, was imported,
  // or is an install backfill (subscribe-time terms unknowable) — all exempt.
  // The effective window is min(this, the covering config's CURRENT
  // lockDays): raising the plan's value never retro-locks an existing
  // subscriber, lowering or disabling releases them immediately. Resolution
  // lives in app/lib/contracts/lock.server.ts.
  lockDays                        Int?
  // Origin + lifecycle
  originOrderId                   String?
  originOrderName                 String?
  // Origin (checkout) order money mirror (migration 0006). The first payment
  // never becomes a BillingAttempt, so before these columns cohort/LTGP/rollup
  // revenue was structurally renewals-only. Captured from getOrderSummary when
  // the contract is mirrored (create webhook / sync) and backfilled by the
  // daily origin_order_backfill job; null = not captured yet. Money semantics
  // mirror BillingAttempt: originOrderTotalCents is the amount as charged
  // (never rewritten), originOrderRefundedCents accumulates REFUNDS_CREATE
  // refunds matched by originOrderId and analytics net it out. NOTE:
  // lifetimeRevenueCents deliberately KEEPS its renewals-only meaning
  // (revenue billed by this app) — origin money is added in cohort/LTGP and
  // rollup aggregates from these columns instead.
  originOrderTotalCents           Int?
  originOrderDiscountCents        Int?
  originOrderShippingChargedCents Int?
  originOrderRefundedCents        Int       @default(0)
  originOrderProcessedAt          DateTime?
  originOrderCurrencyCode         String?
  // Buy-box design of the origin checkout (migration 0025, v1.26.0) — the
  // per-subscriber copy of SubscribableOrder's design record so retention,
  // survival and LTGP can be split by widget design (segment dimensions
  // "design" / "preselect"). WRITE-ONCE: stamped when the origin order's
  // design fact is joined (contract create tail, ORDERS_CREATE race path or
  // the nightly design_facts_backfill), never overwritten — a subscriber is
  // attributed to exactly the design that acquired them, forever.
  // DELIBERATELY NOT in the acq* family: a design label is not personal
  // data, and the merchant decided (v1.26.0) it must survive
  // CUSTOMERS_REDACT so LTGP-by-design stays whole. Do NOT add these to the
  // redact anonymizer's null list.
  //   originDesignKey        preset key ("subscription_max"…), null = unknown
  //   originDesignPreselect  "sub" | "one" | null(unknown) — was subscription
  //                          preselected on the widget that sold this?
  //   originDesignRevisionId WidgetDesignRevision.id live at checkout (calendar)
  //   originDesignSource     "seen" | "design_prop" | "calendar" | "none"
  originDesignKey                 String?
  originDesignPreselect           String?
  originDesignRevisionId          String?
  originDesignSource              String?
  originDesignStampedAt           DateTime?
  // Origin money mirror, continued (migration 0016): the tax share of the
  // origin total (getOrderSummary), so net-of-tax revenue math can stop
  // treating the checkout payment as tax-free; and the origin order's first
  // fulfillment timestamp, so delivery-experience analytics can measure the
  // pay→ship gap for cycle 0 the way BillingAttempt.fulfilledAt does for
  // renewals. Filled by the same capture-at-mirror / origin_order_backfill
  // paths as the 0006 columns; null = not captured yet.
  originOrderTaxCents             Int?
  originOrderFulfilledAt          DateTime?
  // Terminal marker for the daily origin MONEY capture (migration 0011):
  // stamped by origin_order_backfill when getOrderSummary conclusively
  // reports the origin order unfetchable (order-not-found: deleted,
  // GDPR-erased, or older than the 60-day order-access horizon without the
  // read_all_orders scope) for a contract mirrored longer ago than
  // ORIGIN_CAPTURE_GRACE_MS. Stamped rows leave the capped oldest-first
  // pending window so permanently unfetchable orders cannot starve it —
  // the money-pass twin of acqPickupExhaustedAt below. The capture-at-sync
  // path deliberately ignores this marker: a later successful fetch still
  // fills the mirror via its atomic originOrderTotalCents-null claim, so a
  // premature stamp is self-healing.
  originCaptureExhaustedAt        DateTime?
  // Acquisition & behavior data foundation (migration 0006, additive-only
  // ingest — see docs/DATA_FOUNDATION.md). Captured from the origin order's
  // ORDERS_CREATE payload + customer record, SANITIZED before persistence
  // (URLs keep host + path + utm_* only; never raw IP, never the full user
  // agent). All nulled by the CUSTOMERS_REDACT anonymizer.
  acqReferringSite                String?
  acqLandingSite                  String?
  acqSourceName                   String?
  acqUtm                          Json? // {source,medium,campaign,term,content}
  acqCountryCode                  String?
  acqCity                         String?
  acqProvinceCode                 String?
  acqDeviceType                   String? // "mobile" | "desktop" | "tablet" | null
  acqTimeToPurchaseSeconds        Int? // customer created_at → origin order processed_at
  acqUnitsFirstOrder              Int?
  acqOrderValueBand               String? // decile-friendly band label (raw total kept alongside)
  acqRaw                          Json? // whole sanitized bundle for future mining — additive only, never repurposed
  // Terminal marker for the daily acquisition stash pickup (migration 0010):
  // stamped by origin_order_backfill once the stash-race horizon has passed
  // and no "acquisition.captured" stash exists for this contract (pre-0006
  // rows whose ORDERS_CREATE predates the stash feature can never grow one),
  // and by CUSTOMERS_REDACT (the stash payloads are cleared with the
  // identity). Stamped rows leave the capped acqPending window so unfillable
  // rows cannot starve it. The ORDERS_CREATE direct-persist path deliberately
  // ignores this marker — a genuinely late order webhook still lands its data.
  acqPickupExhaustedAt            DateTime?
  firstChargeAt                   DateTime?
  ordersCount                     Int       @default(0) // successful cycles billed
  // Renewal revenue collected on this contract, NET of recorded refunds since
  // v1.4.0 (REFUNDS_CREATE decrements it, clamped at zero). DELIBERATELY
  // renewals-only ("billed by this app"): the origin (checkout) payment is
  // mirrored separately in originOrderTotalCents below, and cohort/LTGP/rollup
  // aggregates add it from there — this column's meaning never changed.
  lifetimeRevenueCents            Int       @default(0)
  // Discount cents granted across this contract's RENEWAL orders. Gained its
  // first writer in the 0016 data-collection pass: settlement increments it
  // with the renewal order's discount total (BillingAttempt.discountCents).
  // Renewals-only like lifetimeRevenueCents — origin (checkout) discount is
  // mirrored separately in originOrderDiscountCents. Rows settled before the
  // writer existed read 0 = "not tracked", not "no discount".
  lifetimeDiscountCents           Int       @default(0)
  // DEPRECATED (dead column): no code writes it — per-contract gross profit
  // is derived from BillingAttempt rows via the shared cost model instead
  // (app/lib/analytics/costs.server.ts). Kept because migrations are
  // additive-only; do not read.
  estLifetimeGrossProfitCents     Int       @default(0)
  // Offer/discount bookkeeping
  grandfatheredPricing            Boolean   @default(false)
  // Consolidation ("routine box"): contracts sharing a mergeGroupId + date bill together
  mergeGroupId                    String?
  // Risk & prediction (analytics jobs keep these fresh)
  churnRiskScore                  Float?    @default(0)
  predictedEmptyDate              DateTime?
  // Predicted LTGP (migration 0020): written nightly by predicted_ltgp_run
  // (app/lib/analytics/predicted-ltgp.server.ts) for countable ACTIVE/PAUSED
  // contracts. Shape predictedLtgpSchema {v:1, horizons:{d90|d180|y1|y3|y5:
  // {cents, grade}}, basis} — see the module for the honest-disclosure rules
  // (grades, estimated flags). Null = never scored (foreign/demo/terminal).
  predictedLtgp                   Json?
  predictedLtgpAt                 DateTime?
  // Day-one snapshot: stamped ONCE the first time the job scores a contract
  // younger than 8 days, never overwritten. ltgp_accuracy_run compares these
  // frozen predictions against matured actuals (machine setting
  // `ltgpAccuracy`) so the model grades its own homework.
  predictedLtgpInitial            Json?
  // Survey-intervention holdout (migration 0020): deterministically assigned
  // when a survey links to this contract (hash of contract id vs the
  // survey.holdoutPct setting). TRUE = survey-answer-triggered flows must
  // exclude this contract, so each answer segment's measured churn stays
  // uncontaminated by the interventions the answers trigger. Assigned once,
  // never reshuffled; null = pre-feature row or no survey.
  surveyHoldout                   Boolean?
  skipCount                       Int       @default(0)
  lastSkippedAt                   DateTime?
  // Skips initiated by the merchant/admin (migration 0016), counted apart
  // from skipCount so churn-risk features read CUSTOMER intent only — an
  // admin skipping a cycle around a stockout is not a disengagement signal.
  merchantSkipCount               Int       @default(0)
  // Save/win-back bookkeeping
  savedAt                         DateTime? // last time a cancel was averted
  winbackEligibleAt               DateTime?
  // Local-only demo contract for the admin portal preview: fake
  // shopifyContractId ("gid://cellexia/demo/..."), never billed, excluded from
  // jobs/analytics/Klaviyo. Portal queries include it on purpose.
  isDemo                          Boolean   @default(false)
  // Which app owns this contract. The shop may run another subscription app
  // (e.g. Joy) whose contracts arrive on the same SUBSCRIPTION_CONTRACTS_*
  // webhooks and get mirrored here. Only OURS is billable / emailable /
  // analysable / manageable in the portal; UNKNOWN is fail-safe (treated as
  // NOT ours everywhere it matters) until an admin claims it.
  // OURS | FOREIGN | UNKNOWN — see app/lib/ownership/ownership.server.ts.
  //
  // The DEFAULT IS THE FAIL-SAFE VALUE, not the common one. Every insert path
  // writes this column explicitly (the webhook mirror classifies it, both
  // import paths and the portal demo fixture stamp OURS), so the default is
  // never the deciding vote for a contract the app knowingly creates — it is
  // only ever reached by a `create()` that FORGOT the column. Defaulting that
  // mistake to OURS would enrol an unclassified contract into the billing
  // sweep, which is the one failure this column exists to prevent; defaulting
  // it to UNKNOWN makes the same mistake cost a renewal that waits until
  // reclassifyContracts() decides it. Wrong-and-recoverable beats
  // wrong-and-charged-twice, so the column leans UNKNOWN.
  ownership                       String    @default("UNKNOWN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lines           ContractLine[]
  billingAttempts BillingAttempt[]
  dunningCases    DunningCase[]
  giftGrants      GiftGrant[]
  discountGrants  DiscountGrant[]
  cancelSessions  CancelSession[]
  events          SubscriberEvent[]
  surveyResponses SurveyResponse[]

  @@index([shopId, status])
  @@index([shopId, nextBillingDate])
  @@index([shopId, email])
  @@index([customerId])
  @@index([mergeGroupId])
  // Billing/reminder/dunning sweeps all filter shopId + ownership + status and
  // range-scan nextBillingDate; the leading columns also serve the plain
  // ownership counts on the admin pages.
  @@index([shopId, ownership, status, nextBillingDate])
}

model ContractLine {
  id                  String   @id @default(cuid())
  contractId          String
  shopifyLineId       String?
  productId           String
  variantId           String
  title               String
  variantTitle        String?
  sku                 String?
  imageUrl            String?
  quantity            Int      @default(1)
  // Selling plan this line rides on, mirrored from Shopify. The ownership
  // evidence in local form: whose subscription app this contract belongs to is
  // decided by whether these plan ids are in SellingPlanConfig.shopifyPlanIds.
  // Null on lines created without a plan (atomicCreate imports, gifts).
  sellingPlanId       String? // gid://shopify/SellingPlan/...
  sellingPlanName     String?
  currentPriceCents   Int
  compareAtPriceCents Int? // undiscounted price, for "you save X" display
  unitCostCents       Int? // COGS from Shopify inventoryItem, for LTGP
  // Shopify line pricing-policy mirror (migration 0016): the line's
  // {basePrice, cycleDiscounts[]} exactly as the contract query returns it,
  // refreshed on each sync. The price-change apply engine reads it to compute
  // per-line adjustments; a line without one (older syncs, gifts, imports) is
  // recorded SKIPPED_NULL_LINE in PriceChangeContractOutcome instead of being
  // guessed at. Null until the next sync touches the line.
  pricingPolicy       Json?
  isGift              Boolean  @default(false)
  isOneTimeAddon      Boolean  @default(false) // remove after ITS cycle settles (addonCycleIndex)
  // The Shopify billing-cycle index this one-time add-on was staged onto
  // (migration 0012). consumeCycleOnSuccess clears an add-on mirror only when
  // ITS cycle settles — a contract-scoped clear used to delete an add-on the
  // customer staged for cycle N+1 while cycle N's charge was still in flight
  // (nextBillingDate advances optimistically at attempt creation), freeing its
  // addClaimKey and letting the same variant be staged AND charged twice.
  // Null on non-add-on lines and on legacy add-on rows (cleared on any
  // settlement, the old behavior).
  addonCycleIndex     Int?
  addedVia            String   @default("CHECKOUT") // CHECKOUT | PORTAL | MAGIC_LINK | ADMIN | GIFT_ENGINE | SWAP
  // Atomic add claim (migration 0009): addOneTimeAddon / addLine create the
  // mirror row FIRST, keyed "addon:{contractId}:{variantId}" respectively
  // "line:{contractId}:{variantId}", and only then run the multi-second
  // Shopify edit (deleting the row if that edit fails). A concurrent
  // double-tap therefore loses on P2002 and is treated as already-staged —
  // the old read-then-act guard let both requests stage the same add-on and
  // charge the customer twice. Null on every other ingest path (checkout
  // sync, gifts, imports), which stay free to mirror whatever Shopify holds.
  addClaimKey         String?  @unique
  createdAt           DateTime @default(now())

  contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

// ── Billing ───────────────────────────────────────────────────────────────────

enum BillingAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  CHALLENGED
  EXPIRED
}

model BillingAttempt {
  id                String               @id @default(cuid())
  contractId        String
  shopifyAttemptId  String?              @unique
  // Idempotency: unique per (contract, cycle, retry) — Shopify dedupes on this key,
  // making double charges impossible even if the scheduler crashes mid-run.
  idempotencyKey    String               @unique
  cycleIndex        Int // Shopify billing cycle index
  attemptNumber     Int                  @default(1) // 1 = scheduled charge, >1 = dunning retry
  status            BillingAttemptStatus @default(PENDING)
  // Row-insert instant (migration 0022) — the stale sweep's age basis for
  // un-started residue rows, where scheduledFor (= nextBillingDate, possibly
  // days past on an overdue contract) would expire them at birth.
  createdAt         DateTime             @default(now())
  scheduledFor      DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  orderId           String?
  orderName         String?
  amountCents       Int?
  currencyCode      String?
  errorCode         String? // Shopify processing error code
  errorMessage      String?
  declineCategory   String? // SOFT | HARD | AUTH_REQUIRED | null
  // Success-settlement completion marker — the success-side analogue of the
  // failure path's declineCategory-written-LAST contract. Stamped only after
  // EVERY post-claim side effect of a successful charge has run (dunning
  // close, lifecycle, order confirmation, event log). status SUCCESS with
  // settledAt NULL = the process died mid-settlement; a redelivered success
  // webhook re-drives the missing side effects instead of returning early.
  settledAt         DateTime?
  // Failure-engine concurrency lease (migration 0008): onBillingAttemptFailed
  // claims the attempt atomically at entry (updateMany gated on
  // declineCategory IS NULL and a null/expired lease) so a delayed FAILURE
  // webhook racing the stale-attempt sweep cannot run the engine twice —
  // which used to double consecutiveFailures, duplicate the payment-failed
  // email and open two dunning cases. declineCategory stays the
  // processing-COMPLETE marker: a crashed run leaves it null and the lease
  // expires, so a redelivery still re-drives the failure.
  dunningClaimedAt  DateTime?
  originatingAction String               @default("SCHEDULER") // SCHEDULER | DUNNING_RETRY | ADMIN_MANUAL | BACKUP_FALLBACK
  usedBackupPayment Boolean              @default(false)
  // Σ cents refunded against this attempt's order (REFUNDS_CREATE webhook).
  // amountCents keeps the amount originally charged; analytics report
  // revenue net of this column, so the charge history is never rewritten.
  refundedCents     Int                  @default(0)
  // Renewal-order money breakdown (migration 0016), captured from the order
  // at settlement: amountCents keeps the total as charged, these split it
  // into discount / tax / shipping / pre-discount subtotal so rollup + cohort
  // math can report net-of-tax revenue and real discount spend instead of
  // estimating them. Null on attempts settled before 0016 and until the
  // order summary is fetched.
  discountCents     Int?
  taxCents          Int?
  shippingCents     Int?
  subtotalCents     Int?
  // The renewal order's processedAt and first-fulfillment timestamps
  // (migration 0016), from settlement capture + FULFILLMENTS webhooks, so
  // charge→ship latency is measurable per cycle (the renewal twin of
  // originOrderProcessedAt / originOrderFulfilledAt).
  orderProcessedAt  DateTime?
  fulfilledAt       DateTime?
  // Per-charge cost basis (migration 0016): {v:1, cogsCents,
  // estimatedCogsCents, shippingCostCents, fulfillmentCostCents,
  // deliveriesPerCharge, lines[]} captured at settlement through the shared
  // cost model (app/lib/analytics/costs.server.ts), so gross-profit history
  // survives later cost-setting edits — analytics read the snapshot when
  // present and only fall back to live cost resolution for pre-0016 rows.
  costSnapshot      Json?
  // Compliance evidence: stored-credential/MIT flags, 3DS outcome, consent snapshot
  mitEvidence       Json?
  // Churn-episode release marker (migration 0013): stamped on terminal
  // attempts (FAILED/CHALLENGED/EXPIRED) when a win-back reactivation closes
  // the churn episode they belong to AND no dunning case is open. The billing
  // sweep's cycle-history guard ignores superseded rows when deciding whether
  // a cycle's history still owns it — so a reactivated contract whose next
  // billing date lands back inside the still-unbilled failed cycle gets the
  // fresh FIRST attempt it was promised instead of being held forever.
  // History stays append-only: the row and its outcome are preserved, attempt
  // numbering still counts superseded rows (idempotency keys stay unique) —
  // only the row's guard-blocking power is retired.
  supersededAt      DateTime?

  contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, cycleIndex])
  @@index([status, scheduledFor])
}

enum DunningState {
  OPEN
  RETRYING
  AWAITING_CUSTOMER
  AWAITING_3DS
  RECOVERED
  EXHAUSTED
  CANCELLED
}

model DunningCase {
  id                       String       @id @default(cuid())
  contractId               String
  openedAt                 DateTime     @default(now())
  state                    DunningState @default(OPEN)
  triggerAttemptId         String? // the failed attempt that opened the case
  declineCode              String?
  declineCategory          String? // SOFT | HARD | AUTH_REQUIRED
  ladderStep               Int          @default(0) // index into retry schedule
  nextRetryAt              DateTime?
  paydayAligned            Boolean      @default(false)
  emailsSent               Int          @default(0)
  smsSent                  Int          @default(0)
  lastNotifiedAt           DateTime?
  resolvedAt               DateTime?
  resolution               String? // RECOVERED | CUSTOMER_FIXED | CANCELLED | EXHAUSTED
  recoveredAttemptId       String?
  recoveredCents           Int?
  // Amount at risk (migration 0016): the ESTIMATED cycle amount at case-open,
  // priced from the contract's lines + delivery at that moment — failed
  // attempts carry no amountCents (Shopify only prices an attempt on
  // success), so recovery reporting had case COUNTS but no money at stake.
  // Estimate, never rewritten; recoveredCents holds the actual. Null on
  // pre-0016 cases.
  amountAtRiskCents        Int?
  amountAtRiskCurrencyCode String?
  // The contract's paymentMethodId at case-open (migration 0016), compared to
  // the method at recovery so analytics can split "customer fixed the card"
  // from "retry ladder got lucky". Null on pre-0016 cases.
  originalPaymentMethodId  String?
  // Position in the CONFIGURED retry ladder consumed so far (migration 0016).
  // ladderStep counts retries performed on this case; ladderCursor pins which
  // schedule entry the next retry reads from, so a mid-case ladder-config
  // edit cannot replay or skip steps. Null = pre-0016 case; the engine falls
  // back to ladderStep.
  ladderCursor             Int?

  contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // INVARIANT (migration 0008, not expressible in Prisma DSL): at most ONE
  // case per contract may be in an open state at a time, enforced by the
  // Postgres partial unique index "DunningCase_one_open_case_per_contract"
  // ON ("contractId") WHERE state IN (OPEN, RETRYING, AWAITING_CUSTOMER,
  // AWAITING_3DS). ensureOpenCase treats the unique violation (P2002) as
  // "lost the race" and reuses the winner's case.
  @@index([state, nextRetryAt])
  @@index([contractId])
}

// ── Event log (single source for timeline, audit and Klaviyo outbox feed) ─────

model SubscriberEvent {
  id         String   @id @default(cuid())
  shopId     String
  contractId String?
  customerId String?
  email      String?
  type       String // e.g. "contract.created", "cycle.skipped", "dunning.retry_scheduled"
  source     String // SYSTEM | WEBHOOK | ADMIN | CUSTOMER_PORTAL | MAGIC_LINK | SCHEDULER | KLAVIYO
  actor      String? // admin email, "customer", "system"
  payload    Json?
  createdAt  DateTime @default(now())

  contract SubscriptionContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([shopId, type, createdAt])
  @@index([email])
}

// Subscriber-tag ledger (migration 0023, v1.23.0): the tag this app last
// applied to a Shopify customer via the `tagging` setting group. A row exists
// only for customers the tagger has actually written to Shopify for — it is
// what makes the reconcile passes cheap (no Shopify round trip when the
// recorded state already matches the desired one), what a rename needs to
// remove the OLD tag value, and the proof that a removal is taking back OUR
// tag rather than one the merchant typed by hand (no row + no live contract
// = never touch the customer). Written only AFTER the Shopify mutation
// succeeded, so a failed write self-heals on the next reconcile.
model CustomerTagState {
  id         String   @id @default(cuid())
  shopId     String
  customerId String // gid://shopify/Customer/...
  // Whether the subscriber tag is currently applied (as far as this app knows).
  tagged     Boolean
  // The exact tag value last applied — tagsRemove needs the byte-exact string.
  tagValue   String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([shopId, customerId])
}

// ── Magic links, OTP, portal sessions ─────────────────────────────────────────

model MagicLinkToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique // sha256 of the signed token — raw token never stored
  action     String // SKIP_NEXT | DELAY_NEXT | ADD_TO_NEXT | UPDATE_CARD | RESUME | PAUSE | SWAP | CONFIRM_3DS | LOGIN
  contractId String?
  customerId String?
  email      String?
  payload    Json? // action parameters (variantId to add, weeks to delay, ...)
  expiresAt  DateTime
  maxUses    Int       @default(1)
  useCount   Int       @default(0)
  usedAt     DateTime?
  createdVia String? // KLAVIYO_FLOW | DUNNING | ADMIN | PORTAL
  createdAt  DateTime  @default(now())

  @@index([contractId])
  @@index([expiresAt])
}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model PortalSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  email      String
  shopId     String
  // Admin preview session: full portal UI as the subscriber sees it, but every
  // mutating action is intercepted — nothing executes, no Shopify calls.
  isPreview  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ── Gifts, offers, lifecycle incentives ───────────────────────────────────────

model GiftRule {
  id                String   @id @default(cuid())
  shopId            String
  name              String
  trigger           String // ORDER_INDEX | DAYS_SUBSCRIBED | SAVE_FLOW | WINBACK | MANUAL
  orderIndex        Int? // e.g. 1 (first renewal surprise), 2, 6
  daysSubscribed    Int? // e.g. 365 for 1-year milestone
  variantId         String // the gift variant (zero-priced line); for DYNAMIC rules, the FALLBACK variant
  variantTitle      String?
  unitCostCents     Int      @default(0) // COGS — feeds LTGP math
  // FIXED | DYNAMIC (migration 0024). DYNAMIC rules resolve the variant per
  // contract at grant time via the gift picker (gifts.pool setting); variantId
  // stays NOT NULL as the picker's fallback so a rolled-back release — which
  // ignores this column — still grants a real product, never a null.
  selection         String   @default("FIXED")
  // DAYS_SUBSCRIBED rules only (migration 0024): fire at every anniversary
  // multiple of daysSubscribed (365, 730, ...) instead of once. Older code
  // ignores it and keeps the fire-once behavior — additive-safe.
  repeatsAnnually   Boolean  @default(false)
  announceInAdvance Boolean  @default(false) // "stay subscribed and get X" emails
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  grants GiftGrant[]

  @@index([shopId, trigger])
}

enum GiftGrantStatus {
  SCHEDULED
  ADDED
  SHIPPED
  REMOVED
  CANCELLED
}

model GiftGrant {
  id            String          @id @default(cuid())
  contractId    String
  ruleId        String?
  cycleIndex    Int // the billing cycle the gift ships with
  variantId     String
  status        GiftGrantStatus @default(SCHEDULED)
  addedAt       DateTime?
  removedAt     DateTime?
  // Stamped at the ADDED→SHIPPED settlement flip (migration 0016) so
  // analytics can count this gift's COGS even after mirror hygiene later
  // flips the grant REMOVED — the ship fact survives the status machine.
  // Null on grants that shipped before 0016 (status alone said SHIPPED but
  // not when, and lost it on REMOVED).
  shippedAt     DateTime?
  // COGS stamped at grant time for dynamically picked gifts (migration 0024),
  // where the rule's unitCostCents describes the fallback variant, not the
  // picked one. Analytics read grant.unitCostCents → rule.unitCostCents →
  // per-variant cost override → 0. Null on FIXED-rule and pre-0024 grants.
  unitCostCents Int?
  // Producer label (migration 0024): RULE | LADDER | FIRST_ORDER | SAVE_FLOW
  // | WINBACK | REWARDS | MANUAL. Lets analytics split gift spend by origin;
  // null on pre-0024 grants (origin recoverable from ruleId/cycle 0 only).
  source        String?
  createdAt     DateTime        @default(now())

  contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  rule     GiftRule?            @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([contractId, cycleIndex])
}

// Temporary percentage discounts (save offers, win-back, retention) applied for
// N cycles via billing-cycle contract edits — never discount codes.
model DiscountGrant {
  id              String    @id @default(cuid())
  contractId      String
  type            String // SAVE_OFFER | SAVE_OFFER_FINAL | WINBACK | RETENTION | MANUAL
  percent         Int
  cyclesTotal     Int
  cyclesRemaining Int
  grantedBy       String? // admin email / "cancel_flow" / "winback_engine"
  reason          String?
  createdAt       DateTime  @default(now())
  exhaustedAt     DateTime?

  contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

// ── Cancel flow ───────────────────────────────────────────────────────────────

model CancelSession {
  id            String    @id @default(cuid())
  contractId    String
  startedAt     DateTime  @default(now())
  channel       String    @default("PORTAL") // PORTAL | ADMIN | MAGIC_LINK
  reason        String? // TOO_MUCH_PRODUCT | TOO_EXPENSIVE | NOT_SEEING_RESULTS | ...
  reasonDetail  String?
  savesShown    Json? // ordered list of offers presented
  saveAccepted  String? // which save was accepted (SKIP | FREQUENCY | PAUSE | DISCOUNT | SWAP | EDUCATION | FINAL_DISCOUNT)
  outcome       String? // SAVED | CANCELLED | ABANDONED
  completedAt   DateTime?
  // 90-day retention tracking for saved customers
  retainedAt90d Boolean?

  contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([outcome, startedAt])
}

// ── Win-back ─────────────────────────────────────────────────────────────────

model WinbackState {
  id                 String    @id @default(cuid())
  contractId         String    @unique
  shopId             String
  cancelledAt        DateTime
  predictedEmptyDate DateTime // touches are timed to this, not to cancel date
  stage              Int       @default(0) // 0=soft touch, 1=perk, 2=capped discount, 3=sunset
  nextTouchAt        DateTime?
  status             String    @default("ACTIVE") // ACTIVE | WON_BACK | SUNSET | OPTED_OUT
  wonBackAt          DateTime?
  // Stamped when status flips OPTED_OUT (migration 0016) so the suppression
  // is datable and auditable — status alone said "opted out" but not when,
  // which compliance reviews and win-back reporting both need. Null on rows
  // that opted out before 0016.
  optedOutAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([status, nextTouchAt])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model NotificationLog {
  id               String   @id @default(cuid())
  shopId           String
  contractId       String?
  email            String?
  phone            String?
  channel          String // EMAIL | SMS | KLAVIYO_EVENT
  template         String // e.g. "upcoming_order", "payment_failed_1"
  status           String   @default("SENT") // SENT | FAILED | SUPPRESSED
  klaviyoEventName String?
  // KlaviyoOutbox row that carried this notification (migration 0016), so a
  // logged SENT can be traced to the delivery attempt that actually left the
  // building (the outbox retries/fails independently of this log row). Null
  // for channels that bypass the outbox and for pre-0016 rows.
  outboxId         String?
  error            String?
  payload          Json?
  createdAt        DateTime @default(now())

  @@index([contractId, createdAt])
  @@index([shopId, template, createdAt])
}

// Outbox for Klaviyo events — guarantees delivery with retries; nothing is lost
// if Klaviyo is briefly down.
model KlaviyoOutbox {
  id            String    @id @default(cuid())
  shopId        String
  eventName     String
  email         String?
  phone         String?
  profileAttrs  Json?
  properties    Json?
  eventTime     DateTime  @default(now())
  status        String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

// ── Webhook processing (idempotent consumption + failure visibility) ──────────

model WebhookReceipt {
  id          String    @id @default(cuid())
  topic       String
  shopDomain  String
  webhookId   String    @unique // X-Shopify-Webhook-Id header — dedupe key
  payloadHash String?
  status      String    @default("PROCESSED") // PROCESSED | FAILED | SKIPPED_DUPLICATE
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([topic, receivedAt])
  @@index([status])
}

// ── Jobs, locks, monitoring ───────────────────────────────────────────────────

model JobRun {
  id         String    @id @default(cuid())
  jobName    String // billing_run | dunning_run | gift_run | winback_run | rollup_run | klaviyo_flush | ...
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING") // RUNNING | SUCCESS | FAILED
  stats      Json?
  error      String?

  @@index([jobName, startedAt])
}

model JobLock {
  name        String   @id
  lockedUntil DateTime
  owner       String
}

model Alert {
  id         String    @id @default(cuid())
  shopId     String
  type       String // BILLING_RUN_FAILED | WEBHOOK_FAILURES | STUCK_CONTRACTS | CHURN_SPIKE | FAILURE_SPIKE | FAST_SHIPPING_SKIPS | STOCKOUT_RENEWALS
  severity   String    @default("WARNING") // INFO | WARNING | CRITICAL
  message    String
  context    Json?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  notifiedAt DateTime?

  @@index([shopId, resolvedAt, createdAt])
}

// ── Price changes (propagate-with-notice vs grandfather is a setting) ─────────

model PriceChangeBatch {
  id                String    @id @default(cuid())
  shopId            String
  mode              String // PROPAGATE_WITH_NOTICE | GRANDFATHER
  noticeDays        Int       @default(30)
  createdBy         String?
  createdAt         DateTime  @default(now())
  noticeSentAt      DateTime?
  effectiveAt       DateTime?
  appliedAt         DateTime?
  status            String    @default("DRAFT") // DRAFT | NOTICE_SENT | APPLIED | CANCELLED
  items             Json // [{variantId, oldPriceCents, newPriceCents}]
  contractsAffected Int       @default(0)
  // Currency the items' old/new prices are denominated in (migration 0016),
  // stamped from the shop at batch creation so the apply step's currency
  // guard can refuse contracts billed in another currency instead of writing
  // cross-currency cents. Null = pre-0016 batch (readers assume the shop
  // currency, which is what those batches meant).
  currencyCode      String?
}

// Per-contract outcome of a price-change batch (migration 0016). The batch
// used to keep only contractsAffected — an aggregate that could not answer
// "which contract failed, and why", so a half-applied batch was invisible.
// One row per (batch, contract) per phase, appended by the notice + apply
// engines: APPLIED | FAILED | SKIPPED_NULL_LINE (a line had no pricingPolicy
// mirror to adjust) | NOTICE_SENT | NOTICE_FAILED. error carries the
// Shopify/user error verbatim on the *_FAILED rows so retries and audits
// need no log spelunking.
model PriceChangeContractOutcome {
  id         String   @id @default(cuid())
  batchId    String
  contractId String
  status     String // APPLIED | FAILED | SKIPPED_NULL_LINE | NOTICE_SENT | NOTICE_FAILED
  error      String?
  createdAt  DateTime @default(now())

  @@index([batchId])
  @@index([contractId])
}

// ── Analytics ─────────────────────────────────────────────────────────────────

model DailyRollup {
  id                           String   @id @default(cuid())
  shopId                       String
  date                         DateTime // UTC midnight for the shop-tz day
  activeSubscribers            Int      @default(0)
  pausedSubscribers            Int      @default(0)
  newSubscribers               Int      @default(0)
  churnedVoluntary             Int      @default(0)
  churnedInvoluntary           Int      @default(0)
  mrrCents                     Int      @default(0)
  chargedCents                 Int      @default(0)
  discountCents                Int      @default(0)
  giftCogsCents                Int      @default(0)
  estGrossProfitCents          Int      @default(0)
  failedAttempts               Int      @default(0)
  recoveredCents               Int      @default(0)
  openDunningCases             Int      @default(0)
  skips                        Int      @default(0)
  cancels                      Int      @default(0)
  savesOffered                 Int      @default(0)
  savesAccepted                Int      @default(0)
  addonsAttached               Int      @default(0)
  takeRateNum                  Int      @default(0) // new OURS contract mirrors booked on arrival day (not checkouts)
  takeRateDen                  Int      @default(0) // total checkouts of subscribable products
  prepaidActive                Int      @default(0)
  // Cost-model era (migration 0004): refunds recorded in the day window,
  // estimated shipping/fulfillment + payment-fee load of the day's charges, and
  // the share of billedCogs that came from the cogsFallbackPctOfPrice estimate
  // (COGS coverage stat — 0 means all COGS was known from Shopify/overrides).
  refundedCents                Int      @default(0)
  shippingCostCents            Int      @default(0)
  feesCents                    Int      @default(0)
  estimatedCogsCents           Int      @default(0)
  // Data-collection audit (migration 0016): money the currency guards
  // excluded from this row's shop-currency aggregates, made visible instead
  // of silently dropped — a nonzero value tells the merchant the totals are
  // incomplete and by how much (in the foreign amounts' own cents).
  excludedForeignCurrencyCents Int      @default(0)
  // VAT / sales tax as a reporting cost (migration 0019): the tax contained
  // in the day's CHARGED (gross) revenue, subtracted from
  // estGrossProfitCents while the costModel.vat setting is enabled (0
  // otherwise). Like feesCents, booked per charge on its charge day and
  // never credited back when a refund is later recorded — the cohort
  // surface carries the refund-adjusted figure. Captured order tax
  // preferred, country-rate estimate as fallback; the estimated share is
  // disclosed in estimatedVatCents exactly like estimatedCogsCents.
  vatCents                     Int      @default(0)
  estimatedVatCents            Int      @default(0)
  // True on gap-backfilled rollup days whose point-in-time snapshot columns
  // (activeSubscribers, mrrCents, openDunningCases, ...) could not be
  // reconstructed after the fact — the flow columns are real, the snapshots
  // are carried/estimated. Dashboards badge fabricated days instead of
  // presenting them as measured.
  snapshotFabricated           Boolean  @default(false)

  @@unique([shopId, date])
}

// Cohort survival + LTGP: one row per (signup cohort month, months since signup)
model CohortCell {
  id                  String   @id @default(cuid())
  shopId              String
  cohortMonth         String // "2026-07"
  monthOffset         Int // 0,1,2,... months since signup
  cohortSize          Int      @default(0)
  activeRemaining     Int      @default(0)
  revenueCents        Int      @default(0)
  discountCents       Int      @default(0)
  cogsCents           Int      @default(0)
  shippingCostCents   Int      @default(0)
  feesCents           Int      @default(0)
  grossProfitCents    Int      @default(0)
  cumGrossProfitCents Int      @default(0)
  computedAt          DateTime @default(now())
  // Cost-model era (migration 0004): cents refunded against this cell's
  // charges (revenueCents is already net of them), and the share of cogsCents
  // that came from the cogsFallbackPctOfPrice estimate (COGS coverage stat).
  refundedCents       Int      @default(0)
  estimatedCogsCents  Int      @default(0)
  // VAT / sales tax as a reporting cost (migration 0019) — see DailyRollup:
  // subtracted in grossProfitCents while costModel.vat is enabled; the
  // estimated share is disclosed in estimatedVatCents.
  vatCents            Int      @default(0)
  estimatedVatCents   Int      @default(0)

  @@unique([shopId, cohortMonth, monthOffset])
}

// Daily variant-availability snapshot (migration 0016), one row per shop-tz
// day, written by the availability check that fronts the billing/stockout
// machinery: which subscribable variants were unavailable that day
// (unavailableVariantIds, full GIDs) out of checkedVariants looked at.
// Shopify availability is unqueryable retroactively, so without this record
// stockout analytics could never say what was actually out of stock on the
// day a renewal was delayed, skipped or substituted. checkedVariants = 0
// with an empty list means "ran, nothing to check", distinguishable from a
// day with no row at all ("never ran").
model AvailabilitySnapshot {
  id                    String   @id @default(cuid())
  shopId                String
  date                  DateTime // UTC midnight for the shop-tz day (matches DailyRollup.date)
  unavailableVariantIds Json // ["gid://shopify/ProductVariant/...", ...]
  checkedVariants       Int      @default(0)
  createdAt             DateTime @default(now())

  @@unique([shopId, date])
}

// ── Buy-box designer ─────────────────────────────────────────────────────────

// Immutable revision history of the PDP buy-box design config. The latest row
// with publishedAt set is the live design (mirrored to the shop metafield
// cellexia.buybox_design as JSON for Liquid); rows without publishedAt are
// drafts. Restoring an old design creates a new revision — history is
// append-only, so every publish is reversible.
model WidgetDesignRevision {
  id          String    @id @default(cuid())
  shopId      String
  preset      String // one of PRESET_KEYS (app/lib/widget/presets.ts) — 8 presets since v1.6.x
  config      Json // widgetDesignConfigSchema (app/lib/widget/presets.ts), version:1
  createdBy   String? // admin user email / "system"
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  // Merchant-given name for the design (migration 0025, v1.26.0) — "Test 1:
  // sub preselected", shown in the revision history and the Results tab so a
  // measurement period reads as a named design, not a cuid. Optional.
  label       String?

  @@index([shopId, createdAt])
}

// ── Design measurement (v1.26.0, migration 0025) ────────────────────────────
//
// One row per SUBSCRIBABLE storefront order (the take-rate denominator
// population — the same order set the "checkout.subscribable" event feed
// counts, now as a relational fact instead of a JSON payload) carrying the
// buy-box design the shopper saw, whether the order started a subscription,
// and the hygiene flags a per-design readout must disclose. Written by
// ORDERS_CREATE (app/lib/design-measurement/facts.server.ts), completed by the
// contract-create tail (subscribed/contractId) and the nightly
// design_facts_backfill job. PII-free by construction: no email, no customer
// id — nothing here needs CUSTOMERS_REDACT.
//
// design* resolution ladder (designSource): "seen" (the widget's always-on
// `_cellexia_seen` line property — preset|preselect, stamped on one-time AND
// subscription adds of our product) → "design_prop" (`_cellexia_design`,
// subscription adds only) → "calendar" (the design the published-revision
// ledger says was live for the order's market at processedAt) → "none".
// calendarDesignKey is always recorded alongside so stamped-vs-calendar
// agreement can be audited.
model SubscribableOrder {
  id                 String    @id @default(cuid())
  shopId             String
  orderId            String // gid://shopify/Order/…
  orderName          String?
  processedAt        DateTime // order processed_at (created_at fallback)
  countryCode        String? // shipping (billing fallback) country, ISO-2
  currencyCode       String? // presentment currency
  marketHandle       String? // resolved via MarketCountryMap; null = unknown
  deviceType         String? // "mobile" | "desktop" | "tablet" | null
  sourceName         String? // payload.source_name ("web", "shop_app", "pos", …), length-capped
  orderTotalCents    Int? // shop-currency total_price
  units              Int?
  designKey          String? // resolved preset key
  designPreselect    String? // "sub" | "one" | null(unknown)
  designRevisionId   String? // WidgetDesignRevision.id from the calendar
  designSource       String // "seen" | "design_prop" | "calendar" | "none"
  calendarDesignKey  String? // what the ledger said, for the agreement audit
  hasSellingPlanLine Boolean   @default(false)
  ownership          String // "ours" | "foreign" | "mixed" | "none" — selling-plan ids on the lines
  exposure           Boolean   @default(false) // any widget-stamped property on any line
  subscribed         Boolean   @default(false) // a COUNTABLE contract has originOrderId = orderId
  contractId         String? // that contract (no FK — survives contract deletion)
  subscribedAt       DateTime?
  promo              Boolean   @default(false) // discount codes / discount applications on the order
  mixed              Boolean   @default(false) // several designs, or sub + one-time of our product
  transition         Boolean   @default(false) // within 24h after a design publish (carry-over risk)
  staff              Boolean   @default(false) // order email in designMeasurement.excludeEmails
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([shopId, orderId])
  @@index([shopId, processedAt])
  @@index([shopId, designKey, processedAt])
  @@index([shopId, contractId])
}

// Storefront visit ledger (v1.27.0, migration 0026): one row per anonymous
// visitor per shop-day per (design, preselect) they saw the buy box under —
// the CONVERSION denominator that pairs with SubscribableOrder's take-rate
// numerator, written by the widget's own beacon (buy-box-embed.js →
// GET /apps/cellexia-subs/w, app/routes/proxy.w.tsx). "vid" is a random
// browser-local id (no personal data, no cookie), so nothing here needs
// CUSTOMERS_REDACT; rows older than the retention window are pruned by
// design_facts_backfill. Counts are visitor-days ("visits"), deliberately:
// a person returning on another day counts again, and the readout says so.
model WidgetVisitorDay {
  id                String   @id @default(cuid())
  shopId            String
  day               String // YYYY-MM-DD in the shop timezone
  vid               String // anonymous visitor id, 8–32 chars [A-Za-z0-9_-]
  designKey         String // resolved preset key the widget rendered
  designPreselect   String   @default("u") // "sub" | "one" | "u" (unknown)
  countryCode       String? // window.Shopify.country at view time
  marketHandle      String? // via MarketCountryMap; null = unknown
  deviceType        String? // "mobile" | "desktop" | "tablet"
  views             Int      @default(0) // page views where the widget was on screen
  engaged           Boolean  @default(false) // interacted with the widget
  addedToCart       Boolean  @default(false) // added our product from the widget page
  addedSubscription Boolean  @default(false) // …with the subscription option
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())

  @@unique([shopId, day, vid, designKey, designPreselect])
  @@index([shopId, day])
  @@index([shopId, designKey, day])
  @@index([shopId, lastSeenAt]) // lastVisitAt top-1 + self-check "since" count without a ledger sort
}

// Country → Shopify market handle, refreshed from the Admin API (Market
// regions) by design_facts_backfill and at design publish. Orders carry a
// country, not a market; the buy-box design is chosen per market. Cache
// only — rebuilt from Shopify whenever stale.
model MarketCountryMap {
  id           String   @id @default(cuid())
  shopId       String
  countryCode  String
  marketHandle String
  marketName   String?
  updatedAt    DateTime @updatedAt

  @@unique([shopId, countryCode])
}

// ── Migration / import ────────────────────────────────────────────────────────

model ImportBatch {
  id         String    @id @default(cuid())
  shopId     String
  filename   String?
  totalRows  Int       @default(0)
  succeeded  Int       @default(0)
  failed     Int       @default(0)
  status     String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  errors     Json?
}

// Post-purchase survey (migration 0020, v1.21.0): one row per checkout order
// shown the thank-you / order-status survey (extensions/cellexia-survey).
// Keyed by the ORDER because the contract mirror may not exist yet when the
// thank-you page renders (the survey POST usually races the
// SUBSCRIPTION_CONTRACTS_CREATE webhook). Linked to the contract by whichever
// side arrives second — the survey endpoint (mirror already exists), the
// contract-sync CREATE tail, or the daily survey_link_sweep job.
model SurveyResponse {
  id                 String    @id @default(cuid())
  shopId             String
  // gid://shopify/Order/... — the extension reads it from OrderConfirmationApi
  // (Thank You page) / OrderStatusApi (Order status page). One survey per order.
  orderId            String    @unique
  contractId         String?
  customerId         String? // gid://shopify/Customer/... from the session token `sub` claim; null on guest revisit
  source             String // THANK_YOU | ORDER_STATUS — the surface that created the row
  locale             String?
  // Instrument version (survey.questionSetVersion setting at impression time).
  // Wording/options are frozen per version; analytics must never merge answer
  // distributions across versions (the measurement-instrument rule).
  questionSetVersion Int
  // {plannedDuration?, motive?, expectedSpeed?, routine?} — option KEYS from
  // surveyAnswersSchema (app/lib/survey/shared.ts), merged progressively as
  // the shopper taps so partial answers survive abandonment.
  answers            Json?
  shownAt            DateTime  @default(now())
  // First answer write; null with a shownAt = shown-but-skipped, itself a
  // churn signal (the survey_skipped risk feature).
  answeredAt         DateTime?
  // Every question answered.
  completedAt        DateTime?
  linkedAt           DateTime?
  // When the one-shot survey.answered event was emitted (migration 0021).
  // The atomic emission claim AND the sweep's "still owes its event" filter —
  // null on pre-upgrade rows whose event already exists (healed on next scan).
  emittedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop     Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  contract SubscriptionContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([shopId, answeredAt])
  @@index([contractId])
}

// ── Experiments ───────────────────────────────────────────────────────────────

// One row per (shop, experiment, customer): the frozen record that this
// customer was EXPOSED to an experiment decision and which arm they were in
// when it happened (migration 0024). The arm itself is a pure sha256 hash of
// (experimentKey, unit) — deterministic and recomputable, like the survey
// holdout — so this table is not the assignment authority; it is the exposure
// ledger that freezes the arm AT DECISION TIME, so a later allocation change
// can never silently reshuffle customers whose treatment already diverged.
// Readouts resolve arms → contract sets exclusively through these rows.
//
// unit is the lowercased customer email: offers and gifts are per-person
// decisions (a customer with two contracts must never be their own control),
// and cooldowns learned the same lesson. contractId is the contract that
// triggered first exposure — a convenience pointer for readouts, deliberately
// no FK (mirrors CustomerTagState): the row must survive contract deletion.
model ExperimentAssignment {
  id             String   @id @default(cuid())
  shopId         String
  experimentKey  String
  unit           String // lowercased customer email
  arm            String
  contractId     String?
  firstExposedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([shopId, experimentKey, unit])
  @@index([shopId, experimentKey, arm])
}
