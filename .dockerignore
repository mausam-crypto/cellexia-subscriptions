# Build context = source only.
#
# The Dockerfile installs dependencies first (`npm ci`) and then does
# `COPY . .`. Without this file that COPY drops the HOST's node_modules on top
# of the image's, and native binaries are platform-specific: Prisma's query
# engine and esbuild/rollup ship per-platform packages, so a tree installed on
# macOS/Windows makes `npx prisma generate` and `npm run build` fail inside the
# linux image ("invalid ELF header" / "Cannot find module @esbuild/linux-*").
# Anyone who ran `npm ci` locally before `fly deploy` would hit it.
node_modules
build
dist
extensions/*/dist

# Secrets come from the host platform's env at runtime and must never be baked
# into an image layer.
.env
.env.*
!.env.example

# Local-only noise.
.git
.gitignore
.DS_Store
*.log
.cache
.shopify
coverage
prisma/*.db
prisma/*.db-journal

# Not used to build or run the server image.
Dockerfile
.dockerignore
docker-compose.dev.yml
