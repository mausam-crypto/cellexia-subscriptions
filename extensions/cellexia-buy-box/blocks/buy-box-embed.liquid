{%- comment -%} Cellexia Buy Box APP EMBED (target: body) for themes whose product section takes no app blocks — renders the identical cx-buybox-core widget in a hidden wrapper that buy-box-embed.js moves into place (anchor precedence: embed setting, then config placement, then JS heuristics); dormant when the app block is present. HARD RULE: the render stays in MARKUP position, never captured. Full exposition: README "Core snippet internals". {%- endcomment -%}
{%- if request.page_type == 'product' and product != blank and product.selling_plan_groups.size > 0 -%}
{%- liquid
# Anchor precedence: embed setting > published config placement > auto.
assign cx_embed_anchor = block.settings.custom_anchor_selector | strip
assign cx_embed_pos = block.settings.anchor_position | default: 'before'
if cx_embed_anchor == blank
assign cx_embed_cfg = shop.metafields.cellexia.buybox_design.value
if cx_embed_cfg and cx_embed_cfg.placement and cx_embed_cfg.placement.mode == 'selector' and cx_embed_cfg.placement.selector != blank
assign cx_embed_anchor = cx_embed_cfg.placement.selector
assign cx_embed_pos = cx_embed_cfg.placement.position | default: 'before'
endif
endif
-%}
{{ 'buy-box.css' | asset_url | stylesheet_tag }}
<div
class="cx-buybox-embed"
hidden
data-cellexia-embed
data-cellexia-anchor="{{ cx_embed_anchor | escape }}"
data-cellexia-anchor-pos="{{ cx_embed_pos | escape }}"
>
{%- render 'cx-buybox-core',
render_context: 'embed',
product: product,
uid: block.id,
section_id: '',
shopify_attributes: block.shopify_attributes,
design_source: 'app',
heading: 'Choose your ritual',
show_badge: true,
badge_text: '',
preselect_subscription: true,
show_frequency_selector: true,
recommended_frequency_handle: '8 weeks',
savings_format: 'percent',
show_reassurance: true,
accent_color: '#1D1D1B',
compact_mode: false
-%}
</div>
<script src="{{ 'buy-box.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'buy-box-embed.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% schema %}
{"name":"Cellexia Buy Box","target":"body","settings":[{"type":"paragraph","content":"One-toggle setup: enable this embed and press Save — the buy box then mounts itself automatically on every product page with a Cellexia subscription plan (above the add-to-cart area). Use this when your theme's product section cannot take app blocks; if the Cellexia Buy Box APP BLOCK is present on the page, the block wins and this embed stays dormant. Until the app goes live from the Cellexia admin, visitors see nothing either way."},{"type":"text","id":"custom_anchor_selector","label":"Custom anchor selector","info":"Optional CSS selector for the element the widget should attach to, e.g. \".pdp__grey\". Overrides both the automatic placement and the app's Buy box designer → Placement setting. Leave empty for automatic placement — an absent default IS empty; the Shopify CLI rejects an explicit \"default\": \"\" on a text setting at deploy."},{"type":"select","id":"anchor_position","label":"Position relative to anchor","options":[{"value":"before","label":"Before the anchor"},{"value":"after","label":"After the anchor"},{"value":"prepend","label":"Inside, at the start"},{"value":"append","label":"Inside, at the end"}],"default":"before","info":"Only used together with the custom anchor selector."}]}
{% endschema %}
