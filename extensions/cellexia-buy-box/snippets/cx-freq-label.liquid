{%- comment -%}
  cx-freq-label — localized delivery-frequency label for a selling plan.

  Params:
    selling_plan (required) a Liquid selling_plan object
    part         (optional) "select" → full label for the frequency <select>
                            ("Delivery every 8 weeks"); anything else → just
                            the frequency fragment ("8 weeks"), used as the
                            {{ frequency }} variable of the `then_price` copy.

  Strategy: extract the week count from the plan's option values (preferred)
  or its name, but only when the string actually mentions weeks — this avoids
  mislabelling month-based plans. When no week count can be found (or the
  count is 1, where "1 weeks" would read badly), fall back to the raw plan
  name, which Shopify serves already translated when storefront translations
  exist.
{%- endcomment -%}
{%- liquid
  assign weeks_num = 0
  for opt in selling_plan.options
    assign opt_val = opt.value | downcase
    if opt_val contains 'week'
      assign candidate = opt_val | split: ' ' | first | plus: 0
      if candidate > 0
        assign weeks_num = candidate
        break
      endif
    endif
  endfor
  if weeks_num == 0
    assign plan_name_down = selling_plan.name | downcase
    if plan_name_down contains 'week'
      assign name_parts = plan_name_down | split: ' '
      for part_token in name_parts
        assign candidate = part_token | plus: 0
        if candidate > 0
          assign weeks_num = candidate
          break
        endif
      endfor
    endif
  endif
-%}
{%- if weeks_num > 1 -%}
  {%- if part == 'select' -%}
    {{- 'delivery_every' | t }} {{ weeks_num }} {{ 'weeks' | t -}}
  {%- else -%}
    {{- weeks_num }} {{ 'weeks' | t -}}
  {%- endif -%}
{%- else -%}
  {{- selling_plan.name -}}
{%- endif -%}
