{%- comment -%} cx-preset-subscription_ultra_max — v1.11.0: the subscription reads as the PLAIN, NORMAL way of buying (no card chrome, no badge/savings/reassurance by default; the recurring then-line stays — recurrence disclosure is not optional), and the quiet one-time line doubles as the SATELLITE (cx-buybox-satellite, data-cellexia-satellite, data-cellexia-for) that buy-box.js relocates below the theme's whole buy area while the widget is visible. Direct-render partial dispatched by cx-buybox-core: prints ONLY values the core precomputed and passed as render args, computes nothing, renders nothing further. Rules, args, string-space contract, history: README "Core snippet internals". {%- endcomment -%}
<div class="cx-buybox__group cx-buybox__group--submax cx-buybox__group--ultramax" role="radiogroup" aria-labelledby="cx-buybox-label-{{ uid }}">
<div
class="cx-buybox__option cx-buybox__option--sub cx-buybox__submax-card cx-buybox__ultramax-card{% if cx_sub_checked %} is-selected{% endif %}"
data-cellexia-option-wrap="subscription"
>
{%- if cx_show_badge and cx_badge != blank -%}
<span class="cx-buybox__badge">{{ cx_badge }}</span>
{%- endif -%}
<label class="cx-buybox__card">
<input
type="radio"
class="cx-buybox__radio cx-buybox__sr-input"
name="cx-purchase-{{ uid }}"
value="subscription"
id="cx-submax-sub-{{ uid }}"
data-cellexia-option="subscription"
{% if cx_sub_checked %}checked aria-checked="true"{% else %}aria-checked="false"{% endif %}
>
<span class="cx-buybox__card-body cx-buybox__card-body--stack">
<span class="cx-buybox__card-main">
<span class="cx-buybox__title-row">
<span class="cx-buybox__title"{% if cx_sub_label_raw contains '{' %} data-cellexia-tpl="{{ cx_sub_label_raw | escape }}"{% endif %}>{{ cx_sub_label }}</span>
{%- if cx_show_savings -%}
<span class="cx-buybox__save cx-buybox__save--quiet" data-cellexia-save{% if cx_save_tpl_raw != blank %} data-cellexia-tpl="{{ cx_save_tpl_raw | escape }}"{% endif %} {% if cx_save == blank %}hidden{% endif %}>{{ cx_save }}</span>
{%- endif -%}
</span>
{{ cx_price_block }}
</span>
</span>
</label>
{{ cx_freq_control }}
{%- if cx_show_reassurance -%}{{ cx_reassurance_html }}{%- endif -%}
{{ cx_benefits_html }}
</div>
{%- unless product.requires_selling_plan -%}
<div class="cx-buybox__submax-onetime cx-buybox-satellite{% unless cx_sub_checked %} is-selected{% endunless %}" data-cellexia-option-wrap="one_time" data-cellexia-satellite data-cellexia-for="{{ uid }}">
<label class="cx-buybox__submax-choice">
<input
type="radio"
class="cx-buybox__radio cx-buybox__sr-input"
name="cx-purchase-{{ uid }}"
value="one_time"
data-cellexia-option="one_time"
{% unless cx_sub_checked %}checked aria-checked="true"{% else %}aria-checked="false"{% endunless %}
>
<span class="cx-buybox__submax-link"{% if cx_onetime_link_raw contains '{' %} data-cellexia-tpl="{{ cx_onetime_link_raw | escape }}"{% endif %}>{{ cx_onetime_link }}</span>
<span class="cx-buybox__submax-picked">
<svg class="cx-buybox__check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
<path d="M6.5 11.3 3.4 8.2l1-1 2.1 2 5-5.1 1 1z" fill="currentColor"/>
</svg>
<span class="cx-buybox__submax-picked-label">{{ cx_onetime_label }}</span>
<span class="cx-buybox__submax-picked-sep" aria-hidden="true">—</span>
<span class="cx-buybox__submax-picked-price" data-cellexia-onetime-price><span class="cx-price">{{ cx_variant.price | money }}</span></span>
</span>
</label>
<label class="cx-buybox__submax-switchback" for="cx-submax-sub-{{ uid }}" aria-hidden="true">{{ 'switch_back' | t }}</label>
</div>
{%- endunless -%}
</div>