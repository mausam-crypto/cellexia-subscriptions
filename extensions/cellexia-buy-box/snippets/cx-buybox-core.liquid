{%- comment -%} JSON island: localized price strings per variant x plan, ALL RAW (script is raw-text, JS writes textContent); money decoded to RAW exactly once at this boundary (README "Core snippet internals"). {%- endcomment -%}
<script type="application/json" data-cellexia-data>
{
"initialVariant": "{{ cx_variant.id }}",
"initialPlan": "{{ cx_selected_plan.id }}",
"preselect": {% if cx_sub_checked %}true{% else %}false{% endif %},
"requiresSellingPlan": {% if product.requires_selling_plan %}true{% else %}false{% endif %},
"variants": {
{%- for v in product.variants -%}
{%- comment -%} MONEY SAFE to RAW (island boundary): decoded HERE exactly once — money-format entities plus the standard un-escape set, amp LAST. v1.6.8 matrix: cents ride along for exact client comparisons; compareAt only when it beats the price. {%- endcomment -%}
{%- assign v_onetime_raw = v.price | money | strip_html | replace: '&nbsp;', ' ' | replace: '&pound;', '£' | replace: '&euro;', '€' | replace: '&yen;', '¥' | replace: '&cent;', '¢' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' -%}
{%- assign v_compare_raw = '' -%}
{%- if v.compare_at_price != blank and v.compare_at_price > v.price -%}
{%- assign v_compare_raw = v.compare_at_price | money | strip_html | replace: '&nbsp;', ' ' | replace: '&pound;', '£' | replace: '&euro;', '€' | replace: '&yen;', '¥' | replace: '&cent;', '¢' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' -%}
{%- endif -%}
"{{ v.id }}": {
"available": {% if v.available %}true{% else %}false{% endif %},
"oneTime": {{ v_onetime_raw | json }},
"oneTimeCents": {{ v.price | json }},
"compareAt": {{ v_compare_raw | json }},
"plans": {
{%- assign cx_plan_i = 0 -%}
{%- for a in v.selling_plan_allocations -%}
{%- if a.selling_plan_group_id == cx_group.id -%}
{%- liquid
# cx-freq-label (inlined) for this allocation's plan.
assign a_weeks = 0
for a_opt in a.selling_plan.options
assign a_opt_val = a_opt.value | downcase
if a_opt_val contains 'week'
assign a_cand = a_opt_val | split: ' ' | first | plus: 0
if a_cand > 0
assign a_weeks = a_cand
break
endif
endif
endfor
if a_weeks == 0
assign a_plan_name = a.selling_plan.name | downcase
if a_plan_name contains 'week'
assign a_tokens = a_plan_name | split: ' '
for a_tok in a_tokens
assign a_cand = a_tok | plus: 0
if a_cand > 0
assign a_weeks = a_cand
break
endif
endfor
endif
endif
if a_weeks > 1
assign a_freq_raw = a_weeks | append: ' ' | append: cx_lc_weeks_raw
else
assign a_freq_raw = a.selling_plan.name
endif
# "then price every frequency" — locale sentence un-escaped ONCE to RAW, then RAW label and money substituted in.
assign a_adj_count = a.price_adjustments | size
if a_adj_count > 1
assign a_last_adj = a.price_adjustments | last
assign a_ongoing = a_last_adj.price
else
assign a_ongoing = a.price
endif
assign a_ongoing_fmt = a_ongoing | money | strip_html | replace: '&nbsp;', ' ' | replace: '&pound;', '£' | replace: '&euro;', '€' | replace: '&yen;', '¥' | replace: '&cent;', '¢' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
assign a_then_raw = ''
if a_ongoing != a.price
assign a_then = 'then_price' | t: price: '{price}', frequency: '{frequency}'
assign a_then_raw = a_then | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
assign a_then_raw = a_then_raw | replace: '{price}', a_ongoing_fmt | replace: '{frequency}', a_freq_raw | strip
endif
# "Save X" — locale sentence un-escaped to RAW, then the RAW amount substituted in.
assign a_save_cents = v.price | minus: a.price
assign a_pct = 0
if a_save_cents > 0 and v.price > 0
assign a_pct = a_save_cents | times: 100.0 | divided_by: v.price | round
endif
assign a_pct_str = ''
if a_pct > 0
assign a_pct_str = a_pct | append: '%'
endif
assign a_save_raw = ''
if a_save_cents > 0 and v.price > 0
assign a_save_fmt = cx_savings_format
if a_pct < 1
assign a_save_fmt = 'absolute'
endif
assign a_save_abs = a_save_cents | money | strip_html | replace: '&nbsp;', ' ' | replace: '&pound;', '£' | replace: '&euro;', '€' | replace: '&yen;', '¥' | replace: '&cent;', '¢' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
if a_save_fmt == 'absolute'
assign a_save_amt = a_save_abs
elsif a_save_fmt == 'both'
assign a_save_amt = a_save_abs | append: ' (' | append: a_pct | append: '%)'
else
assign a_save_amt = a_pct | append: '%'
endif
assign a_save = 'save_amount' | t: amount: '{amount}'
assign a_save_raw = a_save | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
assign a_save_raw = a_save_raw | replace: '{amount}', a_save_amt | strip
endif
# "price per delivery" — label un-escaped to RAW on its own, THEN the RAW money prepended; a_pd_cents mirrors the JS fallback.
assign a_pd_cents = a.per_delivery_price
if a_pd_cents == blank
assign a_pd_cents = a.price
endif
assign a_pd_money_raw = a_pd_cents | money | strip_html | replace: '&nbsp;', ' ' | replace: '&pound;', '£' | replace: '&euro;', '€' | replace: '&yen;', '¥' | replace: '&cent;', '¢' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
assign a_pd_raw = ''
if a.per_delivery_price != blank and a.per_delivery_price != a.price
assign a_pd_label_raw = cx_lc_per_delivery | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
assign a_pd_raw = a_pd_money_raw | append: ' ' | append: a_pd_label_raw | strip
endif
# "first" and "oneTime" are the theme price-sync comparison pair — RAW via the same money chain.
assign a_first_raw = a.price | money | strip_html | replace: '&nbsp;', ' ' | replace: '&pound;', '£' | replace: '&euro;', '€' | replace: '&yen;', '¥' | replace: '&cent;', '¢' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
-%}
{%- if cx_plan_i > 0 -%},{%- endif -%}
{%- assign cx_plan_i = cx_plan_i | plus: 1 -%}
"{{ a.selling_plan.id }}": {
"first": {{ a_first_raw | json }},
"firstCents": {{ a.price | json }},
"ongoing": {{ a_ongoing_fmt | json }},
"then": {{ a_then_raw | json }},
"save": {{ a_save_raw | json }},
"perDelivery": {{ a_pd_raw | json }},
"pd": {{ a_pd_money_raw | json }},
"freq": {{ a_freq_raw | json }},
"savePct": {{ a_pct_str | json }}
}
{%- endif -%}
{%- endfor -%}
}
}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
}
}
</script>
<noscript>
{%- comment -%} Without JS the widget cannot write selling_plan into the form; showing it would promise a subscription the cart would not contain. {%- endcomment -%}
<style>
#cx-buybox-{{ uid }} .cx-buybox__group,
#cx-buybox-{{ uid }} .cx-buybox__heading,
#cx-buybox-{{ uid }} .cx-buybox__subheading { display: none; }
</style>
</noscript>
</div>
{%- else -%}
{%- liquid
# NO OWNED GROUP: render NOTHING but this invisible admin-diagnostic marker (three hiding layers; carries none of the widget hooks) — README "Core snippet internals". Its data-cellexia-diag-* attributes say WHY nothing matched: every group on the product with its app id and truncated name, whether an allow-list was published, and how many plan ids it carries.
assign cx_diag_groups = ''
for cx_dg in product.selling_plan_groups
assign cx_dg_name = cx_dg.name | slice: 0, 40
assign cx_diag_groups = cx_diag_groups | append: cx_dg.app_id | append: ':' | append: cx_dg_name
unless forloop.last
assign cx_diag_groups = cx_diag_groups | append: ' ~ '
endunless
endfor
assign cx_diag_allow = 'absent'
if cx_allow
assign cx_diag_allow = 'present'
endif
-%}<template class="cx-buybox-nogroup" data-cellexia-no-owned-group hidden style="display:none!important" data-cellexia-diag-group-count="{{ product.selling_plan_groups.size }}" data-cellexia-diag-groups="{{ cx_diag_groups | escape }}" data-cellexia-diag-allowlist="{{ cx_diag_allow }}" data-cellexia-diag-plan-count="{{ cx_allow_plan_count }}" data-cellexia-diag-our-app-id="{{ cx_allow_app_id | escape }}"></template>
{%- endif -%}
{%- endif -%}
