{%- comment -%}
  cx-reassurance — the "Skip, pause or cancel anytime." line with its check
  icon, used by the non-classic presets (the classic branch keeps its
  original inline markup for byte-stable fallback rendering).

  Params:
    text  the reassurance copy, PRE-ESCAPED (resolved via cx-tpl)

  Renders nothing when text is blank.
{%- endcomment -%}
{%- if text != blank -%}
  <p class="cx-buybox__reassurance">
    <svg class="cx-buybox__check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
      <path d="M6.5 11.3 3.4 8.2l1-1 2.1 2 5-5.1 1 1z" fill="currentColor"/>
    </svg>
    {{- text -}}
  </p>
{%- endif -%}
