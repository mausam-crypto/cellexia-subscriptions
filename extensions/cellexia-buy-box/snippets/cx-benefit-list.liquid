{%- comment -%}
  cx-benefit-list — check-mark benefit list (value_stack panel, or any
  preset with layout.showBenefits on).

  Params:
    benefits  array of RAW benefit strings (config override or the four
              locale-file defaults); escaped here
    count     max items to render (layout.benefitCount, 0-5)

  Renders nothing when count is 0 or the list is empty; blank entries are
  skipped so a sparse config array cannot render empty rows.
{%- endcomment -%}
{%- if benefits and count > 0 -%}
  <ul class="cx-buybox__benefits" role="list">
    {%- for b in benefits limit: count -%}
      {%- assign cx_b = b | strip -%}
      {%- if cx_b != blank -%}
        <li class="cx-buybox__benefit">
          <svg class="cx-buybox__check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M6.5 11.3 3.4 8.2l1-1 2.1 2 5-5.1 1 1z" fill="currentColor"/>
          </svg>
          {{ cx_b | escape }}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
