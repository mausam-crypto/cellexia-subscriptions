{%- comment -%}
  cx-tpl — resolve {percent} / {amount} / {frequency} placeholders in a text
  template from the design config (or a locale-file default that was rendered
  with literal placeholder tokens).

  Params:
    tpl        raw template string (possibly containing placeholders)
    percent    e.g. "20%" — may be blank when the plan has no saving
    amount     localized one-time price, e.g. "£49.00"
    frequency  localized frequency fragment, e.g. "8 weeks"

  The template is HTML-escaped BEFORE the values are injected, so
  merchant-authored template text can never smuggle markup while money
  strings (which may contain entities from the shop's money format) stay
  intact. Blank values leave a collapsed, trimmed string — "Subscribe & save
  {percent}" with no saving degrades to "Subscribe & save".

  buy-box.js re-resolves the same raw template (from data-cx-tpl attributes)
  on variant/plan changes using per-plan values from the JSON island.
{%- endcomment -%}
{%- liquid
  assign cx_tpl_out = tpl | escape
  assign cx_tpl_pct = percent | default: ''
  assign cx_tpl_amt = amount | default: ''
  assign cx_tpl_frq = frequency | default: ''
  assign cx_tpl_out = cx_tpl_out | replace: '{percent}', cx_tpl_pct | replace: '{amount}', cx_tpl_amt | replace: '{frequency}', cx_tpl_frq
  assign cx_tpl_out = cx_tpl_out | replace: '  ', ' ' | strip
  echo cx_tpl_out
-%}
