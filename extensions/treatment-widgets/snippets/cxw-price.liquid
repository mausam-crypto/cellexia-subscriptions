{%- comment -%}
  cxw-price — price display helper for the Cellexia treatment widgets.

  Params:
    price        (required) integer minor units (cents) — rendered via | money
    compare_at   (optional) integer minor units; strikethrough when > price
    class        (optional) extra classes on the wrapper span
    hook         (optional) data-attribute name JS uses to live-update the
                 current price, e.g. "cxw-treatment-price"
    compare_hook (optional) data-attribute name JS uses to live-update the
                 compare-at price

  Usage:
    {% render 'cxw-price', price: plan_price, compare_at: variant.price,
       class: 'cxw-card__price', hook: 'cxw-treatment-price',
       compare_hook: 'cxw-treatment-compare' %}
{%- endcomment -%}
<span class="cxw-price{% if class != blank %} {{ class }}{% endif %}">
  <span class="cxw-price__current"{% if hook != blank %} data-{{ hook }}{% endif %}>{{ price | money }}</span>
  {%- if compare_at != blank and compare_at > price -%}
    <s class="cxw-price__compare"{% if compare_hook != blank %} data-{{ compare_hook }}{% endif %}>{{ compare_at | money }}</s>
  {%- elsif compare_hook != blank -%}
    <s class="cxw-price__compare" data-{{ compare_hook }} hidden></s>
  {%- endif -%}
</span>
