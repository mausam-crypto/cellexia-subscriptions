{%- comment -%}
  Cellexia — Cart conversion (Widget F) for the cart page.

  For each eligible one-time line (product has selling plans, no selling plan
  applied to the line) renders one subtle banded row:
  "Make this a Continuous Treatment and save {x}% today" with a one-click
  convert button. Conversion is client-side only: POST /cart/change.js with
  {line, quantity, selling_plan} preserving quantity and variant, then a
  cart:refresh event (page reload on /cart so Liquid re-renders totals).

  Hidden for B2B customers (mirrors the theme's selling-plan bypass).
{%- endcomment -%}

{%- unless customer.b2b? -%}
  {%- assign cxw_max_rows = block.settings.max_rows | default: 3 -%}
  {%- assign cxw_app_match = block.settings.plan_group_app_id | default: 'cellexia' | downcase -%}
  {%- assign cxw_shown = 0 -%}

  <div
    class="cxw cxw-cartconv"
    data-cxw-cart
    style="--cxw-ink: {{ block.settings.ink_color | default: '#1D1D1B' }}; --cxw-accent: {{ block.settings.accent_color | default: '#B1CDED' }}; --cxw-line: {{ block.settings.border_color | default: '#D8D8D8' }}; --cxw-band: {{ block.settings.band_color | default: '#F4F4F4' }};"
    {{ block.shopify_attributes }}
  >
    {%- for item in cart.items -%}
      {%- if cxw_shown >= cxw_max_rows -%}
        {%- break -%}
      {%- endif -%}
      {%- if item.selling_plan_allocation == nil -%}
        {%- comment -%} Same app_id filter as treatment-choice: never surface
            another subscription app's group in the convert row. {%- endcomment -%}
        {%- assign cxw_igroup = nil -%}
        {%- for cxw_g in item.product.selling_plan_groups -%}
          {%- assign cxw_g_app = cxw_g.app_id | downcase -%}
          {%- if cxw_g_app contains cxw_app_match -%}
            {%- assign cxw_igroup = cxw_g -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- unless cxw_igroup -%}
          {%- assign cxw_igroup = item.product.selling_plan_groups | first -%}
        {%- endunless -%}
        {%- if cxw_igroup.selling_plans.size > 0 -%}
          {%- comment -%} Pick the cheapest allocation for this line's variant
              from the first group — allocation prices cover every adjustment
              type (percentage, fixed_amount, price), so the promised saving
              matches what checkout will charge. {%- endcomment -%}
          {%- assign cxw_best_plan = nil -%}
          {%- assign cxw_best_price = 0 -%}
          {%- for cxw_alloc in item.variant.selling_plan_allocations -%}
            {%- if cxw_alloc.selling_plan_group_id == cxw_igroup.id -%}
              {%- if cxw_best_plan == nil or cxw_alloc.price < cxw_best_price -%}
                {%- assign cxw_best_plan = cxw_alloc.selling_plan -%}
                {%- assign cxw_best_price = cxw_alloc.price -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if cxw_best_plan == nil -%}
            {%- assign cxw_best_plan = cxw_igroup.selling_plans.first -%}
            {%- assign cxw_best_price = item.variant.price -%}
          {%- endif -%}
          {%- assign cxw_best_pct = 0 -%}
          {%- if item.variant.price > 0 and cxw_best_price < item.variant.price -%}
            {%- assign cxw_best_pct = item.variant.price | minus: cxw_best_price | times: 100.0 | divided_by: item.variant.price | round -%}
          {%- endif -%}
          {%- assign cxw_shown = cxw_shown | plus: 1 -%}

          <div
            class="cxw-convrow"
            data-cxw-convrow
            data-line="{{ forloop.index }}"
            data-quantity="{{ item.quantity }}"
            data-plan-id="{{ cxw_best_plan.id }}"
            data-percent="{{ cxw_best_pct }}"
            data-product-id="{{ item.product_id }}"
            data-variant-id="{{ item.variant_id }}"
          >
            <div class="cxw-convrow__copy">
              <span class="cxw-convrow__title">{{ item.product.title }}</span>
              <span class="cxw-convrow__line">
                {%- if block.settings.copy_override != blank -%}
                  {{ block.settings.copy_override }}
                {%- elsif cxw_best_pct > 0 -%}
                  {{ 'cellexia.cart.convert_row' | t: percent: cxw_best_pct }}
                {%- else -%}
                  {{ 'cellexia.cart.convert_row_generic' | t }}
                {%- endif -%}
              </span>
              <span class="cxw-convrow__flex">{{ 'cellexia.cart.flexibility' | t }}</span>
            </div>
            <button
              type="button"
              class="cxw-btn cxw-btn--secondary cxw-btn--sm"
              data-cxw-convert
              data-label-done="{{ 'cellexia.cart.converted' | t | escape }}"
            >
              {%- if cxw_best_pct > 0 -%}
                {{ 'cellexia.cart.convert_button' | t: percent: cxw_best_pct }}
              {%- else -%}
                {{ 'cellexia.cart.convert_button_generic' | t }}
              {%- endif -%}
            </button>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Cart: make it continuous",
  "target": "section",
  "javascript": "cellexia-widgets.js",
  "stylesheet": "cellexia-widgets.css",
  "settings": [
    { "type": "text", "id": "copy_override", "label": "Row copy override", "info": "Leave blank to use the translated default with the saving percentage." },
    { "type": "range", "id": "max_rows", "label": "Maximum rows", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "plan_group_app_id", "label": "Selling plan group app ID", "default": "cellexia", "info": "Only the selling plan group whose app_id contains this is offered — keeps other subscription apps' plans out of the convert row." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "ink_color", "label": "Ink", "default": "#1D1D1B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B1CDED" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#D8D8D8" },
    { "type": "color", "id": "band_color", "label": "Band background", "default": "#F4F4F4" }
  ]
}
{% endschema %}
